# ============================================================
# US-ETF-Sniper 환경변수 설정
# 이 파일을 .env 로 복사한 후 실제 값을 입력하세요.
# cp .env.example .env
# ============================================================

# === KIS (한국투자증권) API ===
KIS_MOCK=False                    # False=실투자, True=모의투자
KIS_APP_KEY=your_app_key_here
KIS_APP_SECRET=your_app_secret_here
KIS_CANO=your_account_number      # 계좌번호 (8자리)
KIS_ACNT_PRDT_CD=01               # 계좌상품코드

# === AI / LLM API Keys ===
GEMINI_API_KEY=your_gemini_api_key

# Optional (없으면 Gemini만 사용)
GROK_API_KEY=
DEEPSEEK_API_KEY=
GROQ_API_KEY=

# === Telegram 알림 ===
TELEGRAM_BOT_TOKEN=your_bot_token
TELEGRAM_CHAT_ID=your_chat_id

# === Dashboard ===
DASHBOARD_API_KEY=your_dashboard_key

# === Google OAuth (대시보드 로그인용, 선택) ===
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
