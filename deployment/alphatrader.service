[Unit]
Description=Alpha Trader Trading Bot Auto-Restart Monitor
After=network.target

[Service]
Type=simple
User=ubuntu
WorkingDirectory=/home/ubuntu/AlphaTrader
ExecStart=/bin/bash /home/ubuntu/AlphaTrader/auto_restart_bot.sh
Restart=always
RestartSec=10
StandardOutput=append:/home/ubuntu/AlphaTrader/database/service.log
StandardError=append:/home/ubuntu/AlphaTrader/database/service.log

# Force KST timezone so schedule.at() and naive datetimes align with Korea time
Environment="TZ=Asia/Seoul"

# Telegram Notification Settings (Replace with your actual values)
Environment="TELEGRAM_BOT_TOKEN=your_bot_token_here"
Environment="TELEGRAM_CHAT_ID=your_chat_id_here"

# Dashboard Authentication (Replace with a strong random key)
# Generate one with: python3 -c "import secrets; print(secrets.token_urlsafe(32))"
Environment="DASHBOARD_API_KEY=CHANGE_ME_TO_A_RANDOM_KEY"

[Install]
WantedBy=multi-user.target